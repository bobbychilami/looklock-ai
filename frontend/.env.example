# Frontend environment template.
#
# Copy to `frontend/.env.local` (git-ignored) or export before `npm run dev`.
#
# IMPORTANT: everything prefixed with VITE_ is inlined into the client bundle
# and is therefore PUBLIC. Never place a YouCam API key or any other secret in
# a VITE_* variable. The browser talks only to our own backend.

# Base URL of the LOOKLOCK AI backend. In dev, requests to /api are proxied by
# Vite (see vite.config.ts), so this is only needed when the backend is remote.
VITE_API_BASE_URL=http://localhost:8000
