# ---------------------------------------------------------------------------
# LOOKLOCK AI - environment template
#
# Copy to `.env` (root) and fill in real values. NEVER commit `.env`.
#
# Backend-only secrets. Nothing in this file is exposed to the browser:
# the Vite dev server only receives VITE_* variables, and VITE_* variables
# are public by design. Do not put a YouCam API key in a VITE_* variable.
# ---------------------------------------------------------------------------

# --- Backend: application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Backend: YouCam API (Perfect Corp) ---
# API server host documented at https://docs.makeupar.com/develop/api_server
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com
# Create a key at https://yce.makeupar.com/api-console/en/api-keys/
#
# `YOUCAM_API_KEY` is the canonical spelling. `YOUTCAM_API_KEY` is accepted as
# an alias because the hackathon brief uses that spelling; set exactly one.
YOUCAM_API_KEY=
# YOUTCAM_API_KEY=
# Optional: raise the client-side timeout for slow AI tasks (seconds)
YOUCAM_TIMEOUT_SECONDS=60
# Optional: poll cadence and budget for asynchronous tasks (seconds)
YOUCAM_POLL_INTERVAL_SECONDS=5
YOUCAM_POLL_TIMEOUT_SECONDS=180
# Optional: how long a try-on job stays pollable after it finishes (seconds)
YOUCAM_TRYON_JOB_TTL_SECONDS=900

# --- Backend: CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Backend: product catalogue provider
#
# Which source the app treats as its live catalogue. There is deliberately no
# `auto`: an unset value quietly falling back to a bundled demo is how a
# misconfigured deployment ends up serving invented products while looking
# configured.
#
#   amazon   live Amazon India listings via the official Creators API.
#            Requires the AMAZON_* values below. Until they are all present the app
#            reports "no live catalogue available" and shows no products, rather
#            than quietly serving bundled demo data as if it were real.
#   shopping live Google Shopping via SerpApi (India-first). Requires SERPAPI_API_KEY.
#            The default; there is no silent fallback.
# ---------------------------------------------------------------------------
PRODUCT_PROVIDER=shopping

# --- Backend: Amazon Creators API ---
# Docs: https://affiliate-program.amazon.com/creatorsapi/docs/en-us/introduction
#
# Access requires an enrolled Amazon Associates account, registered API access,
# and qualifying sales in the previous 30 days. Apply at
# https://affiliate-program.amazon.com/creatorsapi/docs/en-us/onboarding
#
# Credentials are created in the Associates console. Never put them in VITE_*.
AMAZON_ENABLED=false
AMAZON_MARKETPLACE=www.amazon.in
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
# Your Associates tracking ID. Amazon requires it on every request.
AMAZON_PARTNER_TAG=
# India is served by Amazon's Europe region. Override only for another locale.
# AMAZON_TOKEN_URL=https://api.amazon.co.uk/auth/o2/token
# Optional tuning
# AMAZON_TIMEOUT_SECONDS=15
# AMAZON_CACHE_TTL_SECONDS=300
# AMAZON_SEARCH_PAGE_SIZE=10

# --- Backend: SerpApi Google Shopping (India-first) ---
# Get API key from https://serpapi.com/
SERPAPI_ENABLED=false
SERPAPI_API_KEY=
SERPAPI_LOCATION=India
SERPAPI_GL=in
SERPAPI_HL=en
SERPAPI_COUNTRY=IN
SERPAPI_SEARCH_ENGINE=google_shopping
SERPAPI_CACHE_TTL_SECONDS=1800
SERPAPI_TIMEOUT_SECONDS=15
SERPAPI_MAX_QUERIES_PER_REQUEST=3
SERPAPI_MONTHLY_SEARCH_LIMIT=100

# ---------------------------------------------------------------------------
# Frontend (public, bundled by Vite - never put secrets here)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
